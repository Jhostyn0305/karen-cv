---
import Icon from '../components/Icon.astro';
import { experience, competencies } from '../data/portfolio';
import Gallery from '../components/Gallery.astro';
import '../styles/global.css';
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/400-italic.css';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#722f44" />
    <meta name="description" content="Karen Taimal, odontóloga general de la Universidad Central del Ecuador. Conoce su formación, experiencia clínica y enfoque humano en Quito, Ecuador." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Karen Taimal · Odontóloga general en Quito</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <a class="brand" href="#inicio" aria-label="Karen Taimal, inicio"><span class="brand-symbol"><Icon /></span><span>Karen Taimal<small>ODONTÓLOGA GENERAL</small></span></a>
      <nav aria-label="Navegación principal"><a href="#competencias">Competencias</a><a href="#trayectoria">Experiencia</a><a href="#galeria">Trabajos</a></nav>
      <a class="header-contact" href="#contacto">Contactar <Icon name="diagonal" /></a>
    </header>
    <main id="contenido">
      <section class="hero" id="inicio" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow hero-enter"><span class="status-dot"></span> DISPONIBLE PARA NUEVAS OPORTUNIDADES</p>
          <h1 id="hero-title" class="hero-enter">Karen <em>Taimal</em></h1>
          <p class="hero-role hero-enter">Odontóloga general</p>
          <p class="hero-description hero-enter">Experiencia en atención integral, odontología restauradora y rehabilitación oral, en clínicas privadas y servicio de salud rural.</p>
          <p class="hero-location hero-enter"><Icon name="pin" /> Quito, Ecuador <span>·</span> Universidad Central del Ecuador</p>
          <div class="hero-actions hero-enter"><a class="button button-dark" href="/documents/CV-Karen-Taimal.pdf" download>Ver CV <Icon name="download" /></a><a class="button button-outline" href="#contacto">Contactar <Icon name="diagonal" /></a></div>
          <ul class="hero-facts hero-enter" aria-label="Perfil resumido"><li><Icon name="shield" /> Servicio rural culminado</li><li><Icon name="heart" /> Atención a todas las edades</li><li><Icon name="book" /> Inglés B2</li></ul>
        </div>
        <div class="hero-art" aria-label="Ilustración interactiva de un diente">
          <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
          <div id="tooth-scene"><img class="tooth-fallback" src="/images/tooth.svg" width="500" height="580" alt="Diente de porcelana ilustrado" /></div>
          <div class="floating-note note-one"><Icon name="sparkle" /><span>Precisión clínica</span></div>
          <div class="floating-note note-two"><Icon name="heart" /><span>Trato cercano</span></div>
          <div class="scene-controls"><button id="motion-toggle" type="button" aria-pressed="false" hidden>Pausar movimiento</button></div>
        </div>
      </section>
      <section class="section skills-section" id="competencias" aria-labelledby="skills-title">
        <div class="section-heading"><div><p class="eyebrow section-label">01 — LO QUE PUEDO APORTAR</p><h2 id="skills-title">Competencias clínicas</h2></div><p>Diagnóstico, planificación y atención integral.</p></div>
        <div class="skills-grid">{competencies.map(skill => <article class="skill-card"><Icon name={skill.icon} /><div><h3>{skill.title}</h3><p>{skill.description}</p></div></article>)}</div>
        <div class="clinical-method"><Icon name="shield" /><span>Aislamiento absoluto y aplicación de protocolos de bioseguridad.</span></div>
      </section>
      <section class="section experience-section" id="trayectoria" aria-labelledby="experience-title">
        <div class="section-heading reveal"><div><p class="eyebrow section-label">02 — RECORRIDO PROFESIONAL</p><h2 id="experience-title">Experiencia</h2></div><a class="text-link" href="/documents/CV-Karen-Taimal.pdf" download>CV completo <Icon name="download" /></a></div>
        <div class="experience-list">{experience.map(item => <details class="experience-item"><summary><span class="experience-date">{item.years}</span><span class="experience-position"><strong>{item.title}</strong><span>{item.place}</span></span><span class="experience-location">{item.location}</span><span class="details-indicator" aria-hidden="true">+</span></summary><div class="experience-description"><p>{item.description}</p></div></details>)}</div>
      </section>
      <Gallery />
      <section class="section qualifications-section" id="perfil" aria-labelledby="qualifications-title">
        <div class="section-heading reveal"><div><p class="eyebrow section-label">04 — FORMACIÓN Y HABILIDADES</p><h2 id="qualifications-title">Preparación y forma de trabajar</h2></div></div>
        <div class="qualifications-grid">
          <div class="qualification-card"><h3><Icon name="book" /> Formación</h3><dl><div><dt>Odontología · 2025</dt><dd>Universidad Central del Ecuador</dd></div><div><dt>RCP y primeros auxilios</dt><dd>Certificación</dd></div><div><dt>Idiomas</dt><dd>Español nativo · Inglés intermedio B2</dd></div></dl></div>
          <div class="qualification-card"><h3><Icon name="heart" /> Habilidades personales</h3><ul class="personal-skills"><li>Comunicación empática con el paciente</li><li>Trabajo en equipo multidisciplinario</li><li>Organización y planificación clínica</li><li>Resolución de problemas y toma de decisiones</li><li>Ética, responsabilidad y compromiso</li></ul></div>
        </div>
      </section>
      <section class="contact-section" id="contacto"><div class="section contact-inner"><div><p class="eyebrow"><span class="status-dot"></span> QUITO, ECUADOR</p><h2>¿Buscas una odontóloga<br /><em>para tu equipo?</em></h2><p>Conversemos sobre la oportunidad.</p></div><div class="contact-links"><a class="button button-light" href="mailto:karentaimal52@gmail.com">Contactar por correo <Icon name="mail" /></a><a class="button button-outline" href="https://wa.me/593987761700" target="_blank" rel="noopener noreferrer">Escribir por WhatsApp <Icon name="arrow" /></a><a class="contact-email" href="mailto:karentaimal52@gmail.com">karentaimal52@gmail.com</a></div></div></section>
    </main>
    <footer><a class="brand footer-brand" href="#inicio"><Icon /><span>Karen Taimal</span></a><span>Odontología con sentido humano.</span><span>Quito, Ecuador · {new Date().getFullYear()}</span><a href="#inicio" aria-label="Volver al inicio">↑</a></footer>
    <dialog id="gallery-dialog" aria-labelledby="dialog-title"><button class="dialog-close" aria-label="Cerrar imagen"><Icon name="close" /></button><div class="dialog-image-stage"><img id="dialog-image" width="1280" height="1280" alt="" /></div><div class="dialog-toolbar"><button class="dialog-previous" type="button" aria-label="Registro anterior">←</button><span id="dialog-counter" role="status"></span><button class="dialog-next" type="button" aria-label="Registro siguiente">→</button><button class="dialog-zoom" type="button" aria-pressed="false">Ampliar detalle</button><a id="dialog-original" target="_blank" rel="noopener noreferrer">Ver original ↗</a></div><div class="dialog-copy"><span class="eyebrow" id="dialog-category">ARCHIVO CLÍNICO</span><h2 id="dialog-title"></h2><p id="dialog-description"></p></div></dialog>
    <script>import '../scripts/main';</script>
  </body>
</html>
